> object UpdateOper javascript
	var user = rs.currentUser();
	
    var Oper = rs.getUservar(user, 'Oper');

		return Oper.then(function(result) { //Promise resolves
			console.log("result pre= "+result);
			
		//alert("result(Oper)= "+result);
		
		if(result=="plus" || result=="πρόσθεση"){
				 $( ".B0" ).css("background-color"," #6fb3ca");
				 
				 $( ".B0" ).css("color","white");
				 
				  $( "#B3" ).css("background-color","rgb(47, 110, 132)");
				 
				 var ThisValue=$("#B3").attr("value");
				 ThisValue=ThisValue.substr(0,ThisValue.indexOf(' '));
					sessionStorage.setItem("Opera", ThisValue); //Operator
					console.log("Opera="+sessionStorage.getItem("Opera"));
					if(Lang=="Eng"){
						return "Lets do addition then";
					}
					if(Lang=="Gre"){
						return "Πάμε να κάνουμε πρόσθεση";
					}
					
			}
		if(result=="minus" || result=="αφαίρεση"){
				 $( ".B0" ).css("background-color"," #6fb3ca");
				 
				 $( ".B0" ).css("color","white");
				 
				  $( "#B4" ).css("background-color","rgb(47, 110, 132)");
				 
				 var ThisValue=$("#B4").attr("value");
				 ThisValue=ThisValue.substr(0,ThisValue.indexOf(' '));
					sessionStorage.setItem("Opera", ThisValue); //Operator
					console.log("Opera="+sessionStorage.getItem("Opera"));
					if(Lang=="Eng"){
						return "Lets do subtraction then";
					}
					if(Lang=="Gre"){
						return "Τώρα αφαίρεση";
					}
			}
		if(result=="multiplication" || result=="multiply" || result=="πολλαπλασιασμό"){
				 $( ".B0" ).css("background-color"," #6fb3ca");
				 
				 $( ".B0" ).css("color","white");
				 
				  $( "#B5" ).css("background-color","rgb(47, 110, 132)");
				 
				 var ThisValue=$("#B5").attr("value");
				 ThisValue=ThisValue.substr(0,ThisValue.indexOf(' '));
					sessionStorage.setItem("Opera", ThisValue); //Operator
					console.log("Opera="+sessionStorage.getItem("Opera"));
					if(Lang=="Eng"){
						return "Lets do multiplication then";
					}
					if(Lang=="Gre"){
						return "Οκ, πάμε να κάνουμε πολλαπλασιασμό";
					}
					
			}
		if(result=="divide" || result=="division" || result=="διαίρεση"){
				 $( ".B0" ).css("background-color"," #6fb3ca");
				 
				 $( ".B0" ).css("color","white");
				 
				  $( "#B6" ).css("background-color","rgb(47, 110, 132)");
				 
				 var ThisValue=$("#B5").attr("value");
				 ThisValue=ThisValue.substr(0,ThisValue.indexOf(' '));
					sessionStorage.setItem("Opera", ThisValue); //Operator
					console.log("Opera="+sessionStorage.getItem("Opera"));
					if(Lang=="Eng"){
						return "Lets do division then";
					}
					if(Lang=="Gre"){
						return "Να κάνουμε διαίρεση λοιπόν";
					}
			}
		if(result=="random operator" || result=="any operator" || result=="τυχαίο τελεστή"){
				 $( ".B0" ).css("background-color"," #6fb3ca");
				 
				 $( ".B0" ).css("color","white");
				 
				  $( "#B9" ).css("background-color","rgb(47, 110, 132)");
				 
				 var ThisValue=$("#B9").attr("value");
				 ThisValue=ThisValue.substr(0,ThisValue.indexOf(' '));
					sessionStorage.setItem("Opera", ThisValue); //Operator
					console.log("Opera="+sessionStorage.getItem("Opera"));
					if(Lang=="Eng"){
						return "Any operator I like? fine...!";
					}
					if(Lang=="Gre"){
						return "Ότι τελεστή θέλω εγώ? Okey!";
					}
			}
			
			return "result="+result;
		});
	
