//User setter variable: Dificulty

> object UpdateDify javascript
	var user = rs.currentUser();
    var Dify = rs.getUservar(user, 'Dify');
	console.log("Dify= "+Dify);
	
	return Dify.then(function(result) { //Promise resolves
	
	
	
			console.log("Dify pre= "+result);
			console.log("result pre2= "+result);
		if(result=="easy" || result=="εύκολο"){
				$( "#B2" ).hide();
				$( "#B2" ).css("visibility","hidden");
				$( "#B1" ).show();
				$( "#B1" ).css("visibility","visible");
				sessionStorage.setItem("Dify", "easy"); //Dificulty
				console.log("result== "+result);
				
				if(Lang=="Eng"){
					return "Okey, easy questions now!";
				}
				if(Lang=="Gre"){
					return "Εντάξη, θα σου κάνω έυκολες ερωτήσεις απο τώρα!";
				}
			}
		if(result=="hard" || result=="δύσκολο"){
				$( "#B1" ).hide();
				$( "#B1" ).css("visibility","hidden");
				$( "#B2" ).show();
				$( "#B2" ).css("visibility","visible");
				sessionStorage.setItem("Dify", "hard"); //Dificulty
				console.log("result== "+result);
					if(Lang=="Eng"){
						return "Okey, let me ask you some hard questions then!";
					}
				if(Lang=="Gre"){
					return "Εντάξη, θα σου κάνω δύσκολες ερωτήσεις απο τώρα!";
				}
			}
			return "Dify="+Dify;
		});
< object





