-<call>RestartLesson</call>


> object RestartLesson javascript

	RestartLesson();
	if(CurrentUser.Nick=="" || CurrentUser.Nick=="Guest"){
		if(Lang=="Eng"){
			return "You need to log-in before we can start over";
		}
		if(Lang=="Gre"){
			return "Πρέπει να κάνεις είσοδο στον λογαριασμό σου πρώτα!";
		}
	}else{
		if(Lang=="Eng"){		
			return "One second please "+CurrentUser.Nick+", Ok ready, lets go!";
		}		
		if(Lang=="Gre"){		
			return "ένα λεπτό "+CurrentUser.Nick+", έντάξη πάμε!";
		}		
	}		

